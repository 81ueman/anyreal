+void tcp_fdesc::store_opt(int level, int optname, const void *optval, socklen_t optlen) {
+    if (!optval || optlen == 0) return;
+    uint64_t key = ((uint64_t)(uint32_t)level << 32) | (uint32_t)optname;
+    sockopt_store_[key].assign((const char *)optval, (const char *)optval + optlen);
+}
+
+bool tcp_fdesc::replay_opt(int level, int optname, void *optval, socklen_t *optlen) {
+    if (optlen == nullptr) return false;
+    uint64_t key = ((uint64_t)(uint32_t)level << 32) | (uint32_t)optname;
+    auto it = sockopt_store_.find(key);
+    if (it == sockopt_store_.end()) return false;
+    socklen_t want = (socklen_t)it->second.size();
+    if (optval && *optlen >= want) {
+        memcpy(optval, it->second.data(), want);
+    }
+    *optlen = want;
+    return true;
+}
+
 bool tcp_fdesc::is_bgp_conn() const {
     return is_bgp_ && !is_listener;
 }

+// AnyREAL NOS adapter: launch an unmodified GoBGP under the AnyREAL broker.
+// The broker speaks the REAL controller protocol directly (no LD_PRELOAD).
+std::vector<std::string> start_daemons_cmds_gobgp(
+    const std::string &node_name, int node,
+    const std::unordered_map<int, std::string> &neighborList,
+    const std::string &logPath) {
+    std::string peers = neighborList.at(node);
+    std::replace(peers.begin(), peers.end(), ',', ';');
+    const char *root_env = getenv("ANYREAL_ROOT");
+    std::string root = root_env ? root_env : std::string(".");
+    std::string node_str = std::to_string(node);
+    std::string api = "127.0.0.1:" + std::to_string(50050 + node);
+    std::string log = logPath + "/anyreal-node" + node_str + ".log";
+    std::string conf = root + "/tests/m3/node" + node_str + ".toml";
+    std::string run_cmd =
+        "nohup " + root + "/build/anyreal-run --node " + node_str +
+        " --peers \"" + peers + "\" --real --ripc /ripc --mng /ripc/msg_manager_socket -- " +
+        root + "/build/gobgpd -f " + conf + " -l info --api-hosts " + api +
+        " > " + log + " 2>&1 &";
+    return {
+        "mkdir -p /opt/lwc/volumes/ripc/" + node_name + "/",
+        "chmod a+rwx -R /opt/lwc/volumes/ripc/" + node_name + "/",
+        run_cmd,
+    };
+}
+
+std::vector<std::string> stop_daemons_cmds_gobgp(int node) {
+    std::string n = std::to_string(node);
+    // Stop the NOS first so the broker exits on target death, then the broker.
+    return {"pkill -f 'gobgpd -f .*node" + n + ".toml'",
+            "pkill -f 'anyreal-run --node " + n + " '"};
+}

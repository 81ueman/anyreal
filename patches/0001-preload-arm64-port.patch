diff --git a/preload/preload.h b/preload/preload.h
index fa77f93..f612f05 100644
--- a/preload/preload.h
+++ b/preload/preload.h
@@ -49,6 +49,16 @@ extern "C" {
 
 }
 
+// Architecture compatibility helpers.
+// aarch64 does not provide the open()/dup2() syscalls; use openat()/dup3().
+#if defined(__aarch64__)
+#  define REAL_SYSCALL_OPEN(path, flags) syscall(SYS_openat, AT_FDCWD, (path), (flags))
+#  define REAL_SYSCALL_DUP2(oldfd, newfd) syscall(SYS_dup3, (oldfd), (newfd), 0)
+#else
+#  define REAL_SYSCALL_OPEN(path, flags) syscall(SYS_open, (path), (flags))
+#  define REAL_SYSCALL_DUP2(oldfd, newfd) syscall(SYS_dup2, (oldfd), (newfd))
+#endif
+
 #define SPEEDUP_RATIO 1
 
 struct peer {
